# Deployment settings for the demo app. Copy to .env.local (git-ignored) and
# edit; Expo inlines EXPO_PUBLIC_* values into the bundle at build time, so
# rebuild after changing them. Leave a line out to use the app's default.

# Host serving the issuer directory: GET {base}/v1/mimoto/issuers
EXPO_PUBLIC_WALLET_BASE_URL=https://wallet-backend.example.org

# OAuth 2.0 / OIDC provider the holder signs in with (authorization code + PKCE)
EXPO_PUBLIC_OAUTH_AUTHORIZATION_URL=https://auth.example.org/authorize
EXPO_PUBLIC_OAUTH_TOKEN_URL=https://auth.example.org/token
EXPO_PUBLIC_OAUTH_USERINFO_URL=https://auth.example.org/userinfo
EXPO_PUBLIC_OAUTH_CLIENT_ID=wallet-app
EXPO_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3001/redirect
# Space-separated; only scopes the provider defines
EXPO_PUBLIC_OAUTH_SCOPES=openid
